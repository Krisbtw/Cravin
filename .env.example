# Cravin Environment Configuration
# Copy this file to .env and fill in your values

# Database (SQLite for dev, PostgreSQL URL for prod)
DATABASE_URL=sqlite+aiosqlite:///./cravin.db

# JWT Secret (generate a random string: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI API Key (leave blank for mock AI mode)
OPENAI_API_KEY=

# App Settings
APP_NAME=Cravin
APP_ENV=development
DEBUG=true

# Razorpay (mocked in Phase 1)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps (optional for MVP)
GOOGLE_MAPS_API_KEY=
